{
  "name": "dogfood",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <26"
  },
  "workspaces": [
    "services/*",
    "packages/*",
    "infra/teleport"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "agent": "npm run dev --workspace @dogfood/agent",
    "portal": "npm run dev --workspace @dogfood/portal",
    "build": "npm run build --workspaces --if-present",
    "access-agent": "npm run dev --workspace @dogfood/access-agent"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "urllib": "4.9.1",
    "uuid": "^11.1.1"
  }
}
