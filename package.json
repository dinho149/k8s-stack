{
  "name": "k8s-stack",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <26"
  },
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "agent": "npm run dev --workspace @stack/agent",
    "portal": "npm run dev --workspace @stack/portal",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "urllib": "4.9.1"
  }
}
