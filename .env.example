# Copy to a private environment file; never commit credentials.
DOGFOOD_API_URL=http://127.0.0.1:8088
DOGFOOD_SERVICE_TOKEN=
AGENT_STATE_DIR=.dogfood/agent
AGENT_PROVIDER=bedrock
AGENT_CONCURRENCY=4
AGENT_MAX_BUDGET_USD=0.5
AWS_REGION=eu-west-2
BEDROCK_MODEL=
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=europe-west1
VERTEX_MODEL=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_TEAMS=
TEAMS_APP_ID=
TEAMS_APP_SECRET=
TEAMS_APP_TENANT_ID=
TEAMS_ALLOWED_TENANTS=
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_ALLOWED_DOMAINS=
DOGFOOD_GITHUB_REPOSITORY=
DOGFOOD_GITHUB_TOKEN=

# ---- Teleport (make teleport-*). Defaults are right for the kind stack; nothing below is required locally.
# Which Pulumi stack the teleport-* targets act on (local | dev-eks | dev-gke | dev-aks | prod-eks).
# STACK=local
# Pulumi state backend. Default: a file backend under .dogfood/teleport/pulumi (gitignored), so nothing
# is ever written into whatever Pulumi Cloud account you are logged into. Non-local stacks are REFUSED on a
# file:// backend: use s3://, gs://, azblob:// or https://api.pulumi.com and a KMS secrets provider.
# PULUMI_BACKEND_URL=file://./.dogfood/teleport/pulumi
# Passphrase for the local file backend: STACK=local falls back to the throwaway value 'local-dev';
# every other stack must use a KMS provider or a real passphrase from your secret manager.
# PULUMI_CONFIG_PASSPHRASE=
# Teleport version for the tsh/tctl download (must match the chart major version).
# TELEPORT_VERSION=18.11.1
# Browser-trusted certificate for the local proxy via mkcert: ask (default, once) | 1 (always) | 0 (never).
# LOCAL_TLS=ask
# Open the Teleport web UI with the admin credentials at the end of make teleport-up (1, default) or not (0).
# WEB_LOGIN=1
# GitHub OAuth App for Teleport SSO (stored as Pulumi secrets by make teleport-github-sso).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Access agent credentials for make teleport-agent-cli. Unset = your own Claude Code login (subscription);
# ANTHROPIC_API_KEY switches to the API-key backend; CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token`.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# Local URLs of the in-cluster access services (port-forwards opened by make teleport-port-forward SVC=...).
# TELEPORT_MCP_URL=http://127.0.0.1:18380/mcp
# TELEPORT_BROKER_URL=http://127.0.0.1:18381
# TELEPORT_PORTAL_URL=http://127.0.0.1:18383
# Which seeded Teleport user the local guest sign-in acts as on the Access pages (local-developer -> alice; bob = approver).
# TELEPORT_LOCAL_SUBJECT=local-developer
