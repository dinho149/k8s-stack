# Copy to .env and adjust. The Makefile sources .env automatically.

# Pulumi state backend. Default: a local file backend inside the repo (gitignored),
# so `make up` never writes into whatever Pulumi Cloud account you are logged into.
PULUMI_BACKEND_URL=file://./infra/.state
# Passphrase protecting secrets in the local file backend. Change for anything non-local.
PULUMI_CONFIG_PASSPHRASE=local-dev

# Which stack `make` targets act on by default (local | dev-eks | dev-gke | dev-aks | prod-eks).
STACK=local

# Teleport version used for the tsh/tctl download (must match the chart major version).
TELEPORT_VERSION=18.11.1

# Optional: GitHub OAuth App for SSO. Set via `make github-sso` (stored as Pulumi secrets).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Access agent credentials for `make agent-cli`. Leave both unset to use your own Claude Code login
# (subscription). ANTHROPIC_API_KEY switches to the API-key backend; AUTH=api-key|subscription overrides.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=          # from `claude setup-token`; for the in-cluster agent use `make claude-token`
